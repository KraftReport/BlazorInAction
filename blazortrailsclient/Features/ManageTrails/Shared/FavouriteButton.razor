@using blazortrailsclient.State
@inject AppState AppState

@if (AppState.FavoriteTrailState.IsFavourite(TrailModel))
{
    <button class="btn btn-outline-primary ml-1" title="Favourite" @onclick="@(()=>AppState.FavoriteTrailState.RemoveFavourite(TrailModel))">
        <i class="bi bi-heart-fill"></i>
    </button>
}
else
{
    <button class="btn btn-outline-primary ml-1" title="Favourite" @onclick="@(()=>AppState.FavoriteTrailState.AddFavourite(TrailModel))">
        <i class="bi bi-heart"></i>
    </button>
}


@code {
    [Parameter, EditorRequired] public TrailModel TrailModel { get; set; } = default!;
}
